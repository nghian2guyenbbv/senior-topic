<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- Standard XML ──────────────────────────────────────────────────────── -->

    <route id="jsonToXmlRoute">
        <from uri="direct:jsonToXml"/>
        <unmarshal>
            <json unmarshalType="com.example.demo.model.Order"/>
        </unmarshal>
        <marshal>
            <jacksonXml/>
        </marshal>
    </route>

    <route id="xmlToJsonRoute">
        <from uri="direct:xmlToJson"/>
        <unmarshal>
            <jacksonXml unmarshalType="com.example.demo.model.Order"/>
        </unmarshal>
        <marshal>
            <json/>
        </marshal>
    </route>

    <!-- cXML ──────────────────────────────────────────────────────────────── -->

    <route id="jsonToCXmlRoute">
        <from uri="direct:jsonToCXml"/>
        <unmarshal>
            <json unmarshalType="com.example.demo.model.Order"/>
        </unmarshal>
        <bean ref="orderCXmlTransformer" method="toCXml"/>
        <marshal>
            <jacksonXml/>
        </marshal>
    </route>

    <route id="cXmlToJsonRoute">
        <from uri="direct:cXmlToJson"/>
        <unmarshal>
            <jacksonXml unmarshalType="com.example.demo.model.cxml.CXmlDocument"/>
        </unmarshal>
        <bean ref="orderCXmlTransformer" method="toOrder"/>
        <marshal>
            <json/>
        </marshal>
    </route>

</routes>
